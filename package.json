{
  "name": "demo-simulator",
  "version": "1.1.1",
  "private": true,
  "description": "Offline demo authoring and presentation player",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "npm run typecheck && vite build --config vite.main.config.mts && vite build && node scripts/third-party-notices.cjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:packaged": "node scripts/test-packaged.cjs",
    "package": "npm run build && electron-builder --win nsis zip"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.0",
    "@types/yazl": "^2.4.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": { "minimatch": "^11.0.9" },
  "build": {
    "appId": "local.demosim",
    "productName": "Demo Simulator",
    "files": ["dist/main/**/*", "dist/renderer/**/*", "dist/THIRD_PARTY_NOTICES.txt", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "zip"], "signAndEditExecutable": false },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    }
  }
}
